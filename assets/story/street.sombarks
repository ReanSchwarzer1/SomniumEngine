{
  "version": 1,
  "id": "street",
  "barks": [
    { "id": "spot_1", "trigger": "spotted", "speaker": "guard", "text": "Oi! You there!", "cooldown_ms": 15000 },
    { "id": "spot_2", "trigger": "spotted", "speaker": "guard", "text": "Hold it.", "weight": 2, "cooldown_ms": 15000 },
    {
      "id": "spot_known",
      "trigger": "spotted",
      "speaker": "guard",
      "text": "You again. I said I'd remember.",
      "when": "watch.suspicious",
      "priority": 5,
      "once": true
    },
    { "id": "lamp_lit", "trigger": "lamp_lit", "speaker": "oren", "text": "That's one more!", "when": "lamps.lit < 3" }
  ],
  "chatter": [
    {
      "id": "oil_thief",
      "trigger": "ambient",
      "when": "lamps.lit < 3",
      "cooldown_ms": 120000,
      "lines": [
        { "role": "a", "text": "Third lamp dark this week." },
        { "role": "b", "text": "Somebody's selling the oil out the back of the tannery." },
        { "role": "a", "text": "Don't let the watch hear you say it." }
      ]
    }
  ]
}
